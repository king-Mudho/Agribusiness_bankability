# Next.js SSR server (Node), running the standalone production build.
# Install to: /etc/systemd/system/agribiz-frontend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agribiz-frontend
#
# Serves .next/standalone/server.js -- next.config.ts sets output:
# "standalone", which produces a self-listening Node server plus only the
# dependencies actually needed at runtime, instead of requiring the full
# node_modules tree. deploy/deploy.sh assembles /srv/agribiz/frontend/current
# from .next/standalone plus .next/static and public/ (standalone output
# does not include static assets on its own -- see the Next.js docs).

[Unit]
Description=ABI (agribizframework.com) - Next.js frontend (Node, standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agribiz
Group=agribiz
WorkingDirectory=/srv/agribiz/frontend/current

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# The build itself (not this runtime process) is the memory-hungry step;
# this cap just stops a runtime leak from taking down the whole box.
Environment=NODE_OPTIONS=--max-old-space-size=320

ExecStart=/usr/bin/node /srv/agribiz/frontend/current/server.js

KillMode=mixed
TimeoutStopSec=10
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
