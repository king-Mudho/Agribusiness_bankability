# Django API via gunicorn.
# Install to: /etc/systemd/system/agribiz-backend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agribiz-backend

[Unit]
Description=ABI (agribizframework.com) - Django API (gunicorn)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=notify
User=agribiz
Group=agribiz
WorkingDirectory=/srv/agribiz/backend

# Reads DJANGO_SECRET_KEY, DEBUG, ALLOWED_HOSTS, DATABASE_URL, JWT settings,
# CORS/CSRF origins. Django also loads this file itself via django-environ;
# listing it here means gunicorn's own environment matches.
EnvironmentFile=/srv/agribiz/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/srv/agribiz/backend/venv/bin/gunicorn \
    --config /srv/agribiz/deploy/gunicorn.conf.py \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
Restart=always
RestartSec=3

# Hardening. The app only ever writes to staticfiles/, media/ and its own
# log directory, and needs no other write access on the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/agribiz/backend/staticfiles /srv/agribiz/backend/media /srv/agribiz/logs

[Install]
WantedBy=multi-user.target
