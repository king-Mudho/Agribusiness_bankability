# Production environment for the Next.js frontend.
# Copy to /srv/agribiz/frontend/.env before the first build.
#
#   sudo -u agribiz cp /srv/agribiz/deploy/env-templates/frontend.env.production /srv/agribiz/frontend/.env
#
# NEXT_PUBLIC_* variables are baked into the client-side JS bundle at BUILD
# time, not read at runtime -- if you change one, you must rebuild
# (deploy/deploy.sh does this on every deploy). None of these are secret;
# they end up visible in the browser regardless.

NEXT_PUBLIC_APP_DOMAIN=agribizframework.com

# Same-origin: nginx routes /api/* on this same domain to the Django
# backend (see nginx/agribizframework.conf), so this points back at the
# site's own domain rather than a separate API host.
NEXT_PUBLIC_API_BASE_URL=https://agribizframework.com/api/v1

NEXT_PUBLIC_APP_ENV=production
