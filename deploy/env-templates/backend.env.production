# Production environment for the Django API.
# Copy to /srv/agribiz/backend/.env on the server, then fill in the secrets.
#
#   sudo -u agribiz cp /srv/agribiz/deploy/env-templates/backend.env.production /srv/agribiz/backend/.env
#   sudo -u agribiz chmod 600 /srv/agribiz/backend/.env
#
# This file contains real secrets once filled in -- never commit it, never
# put it in the deployment archive, never paste it into chat/email.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# config/settings/prod.py refuses to start without this set.
DJANGO_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Must be False in production. With DEBUG=True Django serves full stack
# traces and settings to anyone who triggers an error.
DJANGO_DEBUG=False

# Requests with a Host header outside this list are rejected with a 400.
# Included beyond the real domain: server1... and the raw IP, so the
# deployment can be verified before/without relying on DNS.
DJANGO_ALLOWED_HOSTS=agribizframework.com,www.agribizframework.com,server1.agribizframework.com,66.29.139.201

# PostgreSQL, running locally on this same server. The password is the one
# generated by deploy/setup-server.sh -- shown once at the end of that
# script's output, stored nowhere else.
DATABASE_URL=postgres://agribiz_prod:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/agribiz_prod

# Generate with the same command as DJANGO_SECRET_KEY -- use a DIFFERENT
# value, not the same secret reused for two purposes.
JWT_SIGNING_KEY=REPLACE_WITH_GENERATED_SECRET
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Empty in effect: nginx serves the frontend and the API from the same
# origin (see nginx/agribizframework.conf), so the browser never makes a
# cross-origin request. Kept non-empty here only in case the frontend is
# ever split onto its own subdomain.
CORS_ALLOWED_ORIGINS=https://agribizframework.com,https://www.agribizframework.com

# Required for the Django admin login form (and any other session-based
# POST) to be accepted over HTTPS through the reverse proxy -- must include
# the scheme. See config/settings/prod.py.
CSRF_TRUSTED_ORIGINS=https://agribizframework.com,https://www.agribizframework.com

# Celery/Redis intentionally omitted -- see backend/config/settings/base.py:149
